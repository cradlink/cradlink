# Same Firebase project as the web app (copy VITE_FIREBASE_* from the repo root).
EXPO_PUBLIC_BACKEND=firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web client ID from Firebase Authentication → Google.
# In Google Cloud → APIs & Services → Credentials → that Web client,
# add this exact Authorized redirect URI (required for Expo Go):
#   https://auth.expo.io/@ljubogdan/cradlink
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_EXPO_PROJECT=@ljubogdan/cradlink

# Real Android / iOS OAuth clients only (package + SHA-1 / bundle id).
# Do not paste the Web client ID here — Google rejects that in Expo Go.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
