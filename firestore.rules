rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActivityOrganizer(activityId) {
      return signedIn()
        && exists(/databases/$(database)/documents/activities/$(activityId))
        && get(/databases/$(database)/documents/activities/$(activityId)).data.creatorId
          == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if signedIn() && (
        resource.data.visibility == "public"
        || resource.data.creatorId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["memberCount", "status", "updatedAt"])
      );
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }

    match /activityMembers/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (
        resource.data.userId == request.auth.uid
        || isActivityOrganizer(resource.data.activityId)
      );
    }
  }
}
